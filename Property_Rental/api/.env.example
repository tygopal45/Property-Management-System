# Copy to .env for local development. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://rental:rental@127.0.0.1:5432/rental

# REQUIRED, and there is no default — the app refuses to start without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A placeholder will not do: values like "change-me" are rejected, as is anything under 32
# characters, because a secret that ships in a repository is not a secret.
JWT_SECRET=

GRACE_PERIOD_DAYS=5
COOKIE_SECURE=false
# Comma-separated, exact origins, no wildcard. In development this is the Vite dev server; in
# production it is the Vercel URL and the Render URL. The browser app reaches the API same-origin
# in every environment, so this rarely fires — it is stated rather than relied on.
CORS_ORIGINS=http://localhost:5173
