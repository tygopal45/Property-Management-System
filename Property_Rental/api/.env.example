# Copy to .env for local development. Never commit the real .env.
DATABASE_URL=mysql+pymysql://rental:rental@127.0.0.1:3306/rental

# REQUIRED, and there is no default — the app refuses to start without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A placeholder will not do: values like "change-me" are rejected, as is anything under 32
# characters, because a secret that ships in a repository is not a secret.
JWT_SECRET=

GRACE_PERIOD_DAYS=5
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
